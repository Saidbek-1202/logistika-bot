# Telegram Bot Token (BotFather-dan oling)
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB Connection URI
# Option 1: MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/logistik_bot?retryWrites=true&w=majority

# Option 2: Railroad/Railway (managed MongoDB)
MONGODB_URI=mongodb://user:password@hostname:port

# MongoDB Database Name (default: logistik_bot)
MONGODB_DB=logistik_bot

# Admin IDs (Telegram user IDs, comma-separated)
ADMIN_IDS=your_telegram_user_id

# Support Contact (Telegram username)
SUPPORT_CONTACT=@support_username

# News Channel ID (Telegram username or channel ID, optional)
NEWS_CHANNEL=@news_channel_username
